# Copier ce fichier en `.env` (jamais commité — voir .gitignore) et
# renseigner les valeurs réelles. Notification par email (Gmail), pas SMS
# (Twilio abandonné le 2026-08-27 — voir etat.md, procédure trop lourde pour
# un usage aussi simple).

# Adresse Gmail utilisée pour envoyer ET recevoir (SMTP + IMAP).
GMAIL_ADDRESS=

# Mot de passe d'application Gmail (PAS le mot de passe du compte) :
# myaccount.google.com/apppasswords — nécessite la validation en 2 étapes.
GMAIL_APP_PASSWORD=

# Destinataire des notifications. Vide = GMAIL_ADDRESS lui-même (usage
# personnel mono-utilisateur : on s'envoie l'email à soi-même).
NOTIFY_EMAIL=
