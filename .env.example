# Copier ce fichier en `.env` (jamais commité — voir .gitignore) et renseigner
# les valeurs réelles depuis la console Twilio (https://console.twilio.com).
# L'agent ne remplit jamais ce fichier lui-même : création de compte,
# paiement et récupération des identifiants sont à faire par l'auteur.

# Console Twilio > Account Info
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Numéro Twilio acheté (format E.164, ex: +33756XXXXXX)
TWILIO_FROM_NUMBER=

# Numéro personnel de l'auteur, celui qui reçoit la preview et répond pour valider
TWILIO_TO_NUMBER=

# Optionnel : URL de base publique où les images de preview sont temporairement
# accessibles (nécessaire pour joindre la photo en MMS — Twilio exige une URL
# publique, pas un fichier local). Laisser vide pour un SMS texte seul, sans image.
# Ne pas remplir sans avoir explicitement décidé, avec l'auteur, où et comment
# héberger ces images temporaires (voir AUTOMATISATION.md).
PREVIEW_PUBLIC_BASE_URL=
