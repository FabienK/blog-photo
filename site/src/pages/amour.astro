---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import oreillers from '../assets/publications/amour/oreillers.png';
import tasse from '../assets/publications/amour/tasse.png';
import carnet from '../assets/publications/amour/carnet.png';

const articles = [
	{
		number: '01',
		title: "Deux oreillers, pressés l'un contre l'autre",
		image: oreillers,
		alt: 'Deux oreillers blancs posés côte à côte sur un lit fait avec soin, lumière douce du matin',
		paragraphs: [
			"Un lit fait avec soin, tôt le matin. Rien d'autre à voir qu'un drap tiré et deux oreillers posés côte à côte, légèrement enfoncés l'un dans l'autre — la trace qu'ils gardent toutes les nuits sans qu'on y pense.",
			"L'amour ne se photographie pas souvent dans ce qu'il a de plus discret : une habitude muette, répétée chaque soir depuis des années, qui n'a besoin ni de mot ni de regard pour exister. Ce lit ne dit rien d'un couple — on pourrait y voir deux amis, une fratrie, une vieille habitude de n'importe quelle nature — mais il dit quelque chose de l'amour comme partage d'un espace, nuit après nuit, jusqu'à ce que les objets eux-mêmes en gardent la forme.",
		],
		prompt:
			'Realistic close-up photo of a neatly made bed with crisp white linen, two hollow indentations of different depths pressed side by side into a shared pillow, soft early morning window light, shallow depth of field, no people, no faces, no text.',
	},
	{
		number: '02',
		title: "La tasse ébréchée qu'on n'a pas jetée",
		image: tasse,
		alt: "Deux tasses en céramique identiques sur une étagère en bois, l'une ébréchée sur le bord, lumière chaude de fin d'après-midi",
		paragraphs: [
			"Deux tasses identiques sur une étagère en bois, dans la lumière rasante de fin d'après-midi. L'une porte un éclat net sur le bord — elle aurait dû finir à la poubelle depuis longtemps. Elle est pourtant toujours là, propre, visiblement encore utilisée, juste à côté de sa jumelle intacte.",
			"On remplace facilement un objet neuf. Garder celui qui est abîmé, continuer à s'en servir malgré l'ébréchure qui accroche parfois la lèvre, c'est un choix plus silencieux — celui de préférer l'objet qu'on connaît, avec son défaut familier, à un autre qui serait simplement parfait. L'amour tient aussi de cette fidélité-là : moins le grand geste que la petite décision, répétée sans y penser, de ne pas remplacer ce qui a déjà une histoire.",
		],
		prompt:
			'Realistic close-up photo of two ceramic mugs on a wooden kitchen shelf, one with a small chip on its rim but clean and recently used, standing next to its matching intact twin, warm late afternoon light, no people, no legible text.',
	},
	{
		number: '03',
		title: 'Le même numéro, réécrit chaque année',
		image: carnet,
		alt: "Gros plan sur une page de carnet d'adresses, un même numéro réécrit plusieurs fois à l'encre bleue, lumière de lampe de bureau",
		paragraphs: [
			"Une page de vieux carnet d'adresses, sous la lumière chaude d'une lampe de bureau. Un même numéro, griffonné à l'encre bleue, repassé plusieurs fois au même endroit au fil des années — les couches se superposent, les traits s'épaississent, l'écriture devient presque illisible à force d'avoir été reprise.",
			"Personne ne réécrit un numéro qu'on a oublié : on le réécrit parce qu'on continue d'appeler, année après année, la même personne. Ce geste minuscule et répété — composer encore ce numéro, le noter à nouveau quand l'encre pâlit — est une des formes les plus têtues de l'amour : non pas une déclaration unique, mais un contact qu'on refuse de laisser s'effacer.",
		],
		prompt:
			'Realistic close-up photo of an old worn paper address book page, the same phone number rewritten over the same spot in several different shades of blue ink over the years, soft warm desk lamp light, blurred illegible handwriting, no people.',
	},
];
---

<Base
	title="Amour — Prisme"
	description="Trois photographies générées pour regarder l'amour du côté de ses habitudes les plus discrètes : deux oreillers, une tasse ébréchée, un numéro réécrit à l'encre."
>
	<header class="site-header">
		<div class="wrap site-header__inner">
			<a class="wordmark" href={`${import.meta.env.BASE_URL}/`}>Prisme</a>
			<a class="back-link" href={`${import.meta.env.BASE_URL}/`}>← Toutes les publications</a>
		</div>
	</header>

	<main>
		<section class="pub-header">
			<div class="wrap pub-header__inner">
				<p class="case-ref">Numéro 14 — 22 novembre 2026 — 03 photographies</p>
				<h1 class="pub-title">Amour</h1>
				<p class="pub-intro">
					Ni cœur, ni rose, ni couple enlacé — deux oreillers pressés l'un
					contre l'autre, une tasse ébréchée qu'on garde, un numéro réécrit
					année après année. Trois objets qui ne montrent personne, mais
					portent la trace d'une habitude tenue dans la durée.
				</p>
			</div>
		</section>

		<section class="album">
			<div class="wrap wrap--narrow">
				{
					articles.map((article, i) => (
						<article class="page">
							<span class="page__number" aria-hidden="true">{article.number}</span>
							<div class="page__mount">
								<span class="corner corner--tl" aria-hidden="true" />
								<span class="corner corner--tr" aria-hidden="true" />
								<span class="corner corner--bl" aria-hidden="true" />
								<span class="corner corner--br" aria-hidden="true" />
								<Image
									src={article.image}
									alt={article.alt}
									widths={[480, 900, 1400]}
									sizes="(min-width: 50rem) 34rem, 92vw"
									loading={i === 0 ? 'eager' : 'lazy'}
								/>
							</div>
							<h2 class="page__title">{article.title}</h2>
							<div class="page__body">
								{article.paragraphs.map((p) => (
									<p>{p}</p>
								))}
							</div>
							<div class="page__meta">
								<span>
									Photo générée avec <strong>ShowMe5WH</strong> — modèle{' '}
									<strong>Flux (schnell)</strong> (ComfyUI, en local)
								</span>
								<details>
									<summary>Voir le prompt de génération</summary>
									<p>{article.prompt}</p>
								</details>
							</div>
						</article>
					))
				}
			</div>
		</section>
	</main>

	<footer class="site-footer">
		<div class="wrap">
			<p>
				Photographies générées avec <strong>ShowMe5WH</strong> (ComfyUI, en
				local). Textes et mise en page : l'auteur, assisté de Claude.
			</p>
			<a class="back-link" href={`${import.meta.env.BASE_URL}/`}>← Retour à Prisme</a>
		</div>
	</footer>
</Base>

<style>
	@import url('https://fonts.googleapis.com/css2?family=Domine:wght@500;600;700&family=Hanken+Grotesk:wght@400;500;600;700&display=swap');

	:global(body) {
		--paper: #f2ece1;
		--ink: #2a2318;
		--ink-soft: #6b6153;
		--rule: rgba(42, 35, 24, 0.18);
		--accent: #32496b;
		--accent-strong: #223450;
		--surface-raised: #e8e0d1;
		--font-display: 'Domine', 'Source Serif 4', serif;
		--font-body: 'Hanken Grotesk', -apple-system, sans-serif;
	}

	.site-header {
		padding: 1.75rem 0;
		border-bottom: 1px solid var(--rule);
	}
	.site-header__inner {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
	}
	.wordmark {
		font-family: var(--font-display);
		font-size: 1.3rem;
		font-weight: 600;
		letter-spacing: 0.01em;
		text-decoration: none;
		color: var(--ink);
	}
	.back-link {
		font-family: var(--font-body);
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink-soft);
		text-decoration: none;
		border-bottom: 1px solid transparent;
		transition: border-color 0.25s ease, color 0.25s ease;
	}
	.back-link:hover {
		color: var(--accent-strong);
		border-color: currentColor;
	}

	.pub-header {
		padding: 3.25rem 0 3.5rem;
	}
	.pub-header__inner {
		max-width: 38rem;
	}
	.case-ref {
		font-family: var(--font-body);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--accent-strong);
	}
	.pub-title {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: clamp(2.4rem, 5.2vw + 1rem, 3.8rem);
		letter-spacing: -0.01em;
		margin: 0.7rem 0 1.5rem;
		color: var(--ink);
	}
	.pub-intro {
		font-family: var(--font-body);
		font-size: 1.08rem;
		line-height: 1.65;
		color: var(--ink-soft);
		max-width: 36rem;
		margin: 0;
	}

	.album {
		padding-bottom: 4.5rem;
	}
	.wrap--narrow {
		max-width: 38rem;
	}

	.page {
		position: relative;
		padding: 2.6rem 1.6rem 1.8rem;
	}
	.page + .page {
		border-top: 1px dashed var(--rule);
		margin-top: 2.8rem;
	}

	.page__number {
		position: absolute;
		top: 0.4rem;
		left: 1.6rem;
		width: 2.3rem;
		height: 2.3rem;
		border-radius: 50%;
		border: 1.5px solid var(--accent);
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 0.95rem;
		color: var(--accent-strong);
		background: var(--paper);
		transform: rotate(-4deg);
	}

	.page__mount {
		position: relative;
		margin: 1.4rem 0 1.8rem;
		padding: 0.9rem;
		background: var(--surface-raised);
		box-shadow: 0 1px 0 var(--rule);
	}
	.page__mount :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}
	.corner {
		position: absolute;
		width: 1.6rem;
		height: 1.6rem;
		border: 2px solid var(--accent);
		opacity: 0.75;
		z-index: 1;
	}
	.corner--tl {
		top: 0.5rem;
		left: 0.5rem;
		border-right: none;
		border-bottom: none;
	}
	.corner--tr {
		top: 0.5rem;
		right: 0.5rem;
		border-left: none;
		border-bottom: none;
	}
	.corner--bl {
		bottom: 0.5rem;
		left: 0.5rem;
		border-right: none;
		border-top: none;
	}
	.corner--br {
		bottom: 0.5rem;
		right: 0.5rem;
		border-left: none;
		border-top: none;
	}

	.page__title {
		font-family: var(--font-display);
		font-weight: 600;
		font-style: italic;
		font-size: clamp(1.4rem, 2vw + 1rem, 1.8rem);
		line-height: 1.3;
		letter-spacing: -0.005em;
		margin: 0 0 1.2rem;
		color: var(--ink);
	}

	.page__body p {
		font-family: var(--font-body);
		font-size: 1.02rem;
		line-height: 1.7;
		color: var(--ink);
	}
	.page__body p + p {
		margin-top: 1rem;
	}

	.page__meta {
		margin-top: 1.5rem;
		padding-top: 1.1rem;
		border-top: 1px solid var(--rule);
		font-family: var(--font-body);
		font-size: 0.85rem;
		color: var(--ink-soft);
	}
	.page__meta strong {
		color: var(--ink);
	}
	.page__meta details {
		margin-top: 0.6rem;
	}
	.page__meta summary {
		cursor: pointer;
		color: var(--accent-strong);
		font-weight: 600;
		font-family: var(--font-body);
		font-size: 0.78rem;
		letter-spacing: 0.02em;
	}
	.page__meta details p {
		margin: 0.6rem 0 0;
		font-family: var(--font-body);
		font-style: italic;
		line-height: 1.6;
		color: var(--ink-soft);
	}

	.site-footer {
		padding: 2.5rem 0 3rem;
		border-top: 1px solid var(--rule);
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.site-footer p {
		margin: 0;
		font-family: var(--font-body);
		font-size: 0.9rem;
		color: var(--ink-soft);
	}

	@media (min-width: 50rem) {
		.page__title,
		.page__body,
		.page__meta {
			margin-left: 0.8rem;
			margin-right: 0.8rem;
		}
	}
</style>
