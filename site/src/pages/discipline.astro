---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import rames from '../assets/publications/discipline/rames.png';
import cordeASauter from '../assets/publications/discipline/corde-a-sauter.png';
import chemisesPliees from '../assets/publications/discipline/chemises-pliees.png';

const articles = [
	{
		index: '01',
		title: 'Le manche que la main retrouve chaque matin',
		image: rames,
		alt: "Deux rames en bois appuyées contre le mur d'un hangar à bateaux au lever du jour, manches polis et pâlis par des années de prise identique, pales encore mouillées",
		paragraphs: [
			"Deux rames appuyées contre le mur d'un hangar à bateaux, au lever du jour. Leurs manches ne sont pas neufs : ils sont polis, pâlis, usés exactement là où la main revient, saison après saison, toujours au même endroit sur le bois. Les pales sont encore mouillées — la sortie de l'aube vient de s'achever, une de plus dans une série qui ne compte plus ses répétitions.",
			"La discipline n'est pas un sursaut de volonté ni un exploit ponctuel : c'est ce polissage lent, invisible tant qu'on le regarde une seule fois, qui ne devient visible qu'additionné sur des années. Personne ne décide, un matin donné, d'user ainsi le bois. Cela arrive seulement parce que la main revient, encore, avant que le jour ne soit levé.",
		],
		prompt:
			'Realistic photo of two wooden rowing oars leaning against a weathered boathouse wall at dawn, their handles worn smooth and pale from years of identical grip, blades still wet with water droplets, soft early morning light, no people visible',
	},
	{
		index: '02',
		title: 'Le clou, toujours le même',
		image: cordeASauter,
		alt: 'Corde à sauter enroulée avec soin et suspendue à un clou dans un vestiaire de gymnase vide, lumière basse de fin d’après-midi',
		paragraphs: [
			"Un vestiaire vide, une lumière basse de fin d'après-midi. La corde à sauter n'est pas jetée dans un coin après l'effort : elle est enroulée avec soin et suspendue au même clou que la veille, et que le jour d'avant. L'entraînement lui-même ne se voit pas sur cette photo — seul reste ce geste minuscule qui le referme.",
			"C'est peut-être la part la moins montrée de la discipline : non pas l'effort, qui a des témoins, mais ce qui se passe une fois qu'il n'y en a plus. Ranger l'instrument exactement comme il a toujours été rangé, sans que personne ne le vérifie, sans que cela change jamais rien à la séance déjà terminée — seulement parce que c'est ainsi que les choses se font, ici, tout le temps.",
		],
		prompt:
			'Realistic photo of a jump rope neatly coiled and hanging on a single nail in an empty gym locker room, handles worn smooth, dim late afternoon light through a small window, no people visible',
	},
	{
		index: '03',
		title: 'Le pli qui ne varie pas',
		image: chemisesPliees,
		alt: 'Pile de chemises repassées et soigneusement pliées dans un tiroir en bois ouvert, chaque pli aligné avec une précision identique',
		paragraphs: [
			"Un tiroir ouvert, une pile de chemises repassées. Rien ne distingue le pli du dessus de celui, invisible, tout en bas de la pile — chacun aligné sur le précédent avec la même précision, comme si une règle avait servi à chaque fois, alors qu'il n'y a jamais eu que des mains et une habitude.",
			"C'est une discipline sans spectateur ni enjeu apparent : personne ne félicite un pli bien fait, personne ne remarque un tiroir rangé. Elle tient tout entière dans la constance d'un geste domestique que rien n'oblige à répéter à l'identique — sinon la décision, prise une fois, de ne jamais le laisser varier.",
		],
		prompt:
			'Realistic close-up photo of a stack of neatly folded ironed shirts in an open wooden drawer, each fold aligned with machine-like precision, soft daylight from the side, no people visible',
	},
];
---

<Base
	title="Discipline — Prisme"
	description="Trois photographies générées pour explorer le thème de la Discipline : des rames polies par la prise répétée, une corde à sauter rangée au même clou, une pile de chemises pliées avec une précision constante."
>
	<header class="site-header">
		<div class="wrap site-header__inner">
			<a class="wordmark" href={`${import.meta.env.BASE_URL}/`}>Prisme</a>
			<a class="back-link" href={`${import.meta.env.BASE_URL}/`}>← Toutes les publications</a>
		</div>
	</header>

	<main>
		<section class="pub-header">
			<div class="wrap pub-header__inner">
				<p class="eyebrow">N° 10 — 25 octobre 2026 — 03 photographies</p>
				<h1 class="pub-title">Discipline</h1>
				<p class="pub-intro">
					Ni soldat au pas, ni réveil, ni règle sur la main — un manche de rame poli
					par la prise répétée, une corde à sauter rangée au même clou chaque jour,
					une pile de chemises dont aucun pli ne varie. Trois objets qui ne montrent
					jamais l'effort, seulement sa trace répétée.
				</p>
			</div>
		</section>

		<section class="register">
			<div class="wrap">
				{
					articles.map((article, i) => (
						<article class="row">
							<div class="row__index" aria-hidden="true">
								{article.index}
							</div>
							<div class="row__media">
								<Image
									src={article.image}
									alt={article.alt}
									widths={[480, 900, 1400]}
									sizes="(min-width: 50rem) 34rem, 92vw"
									loading={i === 0 ? 'eager' : 'lazy'}
								/>
							</div>
							<div class="row__content">
								<h2 class="row__title">{article.title}</h2>
								<div class="row__body">
									{article.paragraphs.map((p) => (
										<p>{p}</p>
									))}
								</div>
								<div class="row__meta">
									<span>
										Photo générée avec <strong>ShowMe5WH</strong> — modèle{' '}
										<strong>Flux (schnell)</strong> (ComfyUI, en local)
									</span>
									<details>
										<summary>Voir le prompt de génération</summary>
										<p>{article.prompt}</p>
									</details>
								</div>
							</div>
						</article>
					))
				}
			</div>
		</section>
	</main>

	<footer class="site-footer">
		<div class="wrap">
			<p>
				Photographies générées avec <strong>ShowMe5WH</strong> (ComfyUI, en
				local). Textes et mise en page : l'auteur, assisté de Claude.
			</p>
			<a class="back-link" href={`${import.meta.env.BASE_URL}/`}>← Retour à Prisme</a>
		</div>
	</footer>
</Base>

<style>
	@import url('https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=Inter:wght@400;500;600&display=swap');

	:global(body) {
		--paper: #15171a;
		--ink: #eef0ef;
		--ink-soft: #9aa0a6;
		--rule: rgba(238, 240, 239, 0.16);
		--accent: #e6484f;
		--accent-strong: #c1272d;
		--surface-raised: #1c1f23;
		--font-display: 'Archivo', 'Helvetica Neue', Arial, sans-serif;
		--font-body: 'Inter', -apple-system, sans-serif;
	}

	.site-header {
		padding: 1.75rem 0;
		border-bottom: 1px solid var(--rule);
	}
	.site-header__inner {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
	}
	.wordmark {
		font-family: var(--font-display);
		font-size: 1.35rem;
		font-weight: 700;
		letter-spacing: -0.01em;
		text-decoration: none;
	}
	.back-link {
		font-family: var(--font-body);
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--ink-soft);
		text-decoration: none;
		border-bottom: 1px solid transparent;
		transition: border-color 0.25s ease, color 0.25s ease;
	}
	.back-link:hover {
		color: var(--accent);
		border-color: currentColor;
	}

	.pub-header {
		padding: 3rem 0 3.5rem;
	}
	.pub-header__inner {
		max-width: 38rem;
	}
	.eyebrow {
		font-family: var(--font-body);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--accent);
	}
	.pub-title {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: clamp(2.75rem, 7vw + 1rem, 5rem);
		letter-spacing: -0.02em;
		margin: 0.7rem 0 1.5rem;
		color: var(--ink);
	}
	.pub-intro {
		font-family: var(--font-body);
		font-size: 1.1rem;
		line-height: 1.65;
		color: var(--ink-soft);
		max-width: 34rem;
		margin: 0;
	}

	.register {
		padding-bottom: 4rem;
	}
	.row {
		display: grid;
		grid-template-columns: 2.5rem 1fr;
		gap: 0 1.25rem;
		padding: 2.25rem 0;
		border-top: 1px solid var(--rule);
	}
	.row:last-child {
		border-bottom: 1px solid var(--rule);
	}
	.row__index {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 0.85rem;
		letter-spacing: 0.02em;
		color: var(--accent);
		padding-top: 0.2rem;
	}
	.row__media {
		grid-column: 2;
		border: 1px solid var(--rule);
		background: var(--surface-raised);
	}
	.row__media :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}
	.row__content {
		grid-column: 2;
		margin-top: 1.5rem;
	}
	.row__title {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: clamp(1.35rem, 2vw + 1rem, 1.8rem);
		letter-spacing: -0.01em;
		margin: 0 0 1.1rem;
		color: var(--ink);
	}
	.row__body {
		max-width: 36rem;
	}
	.row__body p {
		font-family: var(--font-body);
		font-size: 1.02rem;
		line-height: 1.7;
		color: var(--ink);
	}
	.row__body p + p {
		margin-top: 1rem;
	}
	.row__meta {
		max-width: 36rem;
		margin-top: 1.1rem;
		padding-top: 1.1rem;
		border-top: 1px solid var(--rule);
		font-family: var(--font-body);
		font-size: 0.78rem;
		letter-spacing: 0.01em;
		color: var(--ink-soft);
	}
	.row__meta strong {
		color: var(--ink);
	}
	.row__meta details {
		margin-top: 0.6rem;
	}
	.row__meta summary {
		cursor: pointer;
		color: var(--accent);
		font-weight: 600;
	}
	.row__meta details p {
		margin: 0.6rem 0 0;
		font-family: var(--font-body);
		font-style: italic;
		line-height: 1.6;
		color: var(--ink-soft);
	}

	.site-footer {
		padding: 2.5rem 0 3rem;
		border-top: 1px solid var(--rule);
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.site-footer p {
		margin: 0;
		font-family: var(--font-body);
		font-size: 0.875rem;
		color: var(--ink-soft);
	}

	@media (min-width: 40rem) {
		.row {
			grid-template-columns: 3.5rem 1fr;
		}
		.row__index {
			font-size: 0.95rem;
		}
	}

	@media (min-width: 60rem) {
		.row {
			grid-template-columns: 4.5rem 22rem 1fr;
			gap: 0 2.5rem;
		}
		.row__media {
			grid-column: 2;
		}
		.row__content {
			grid-column: 3;
			margin-top: 0;
		}
	}
</style>
